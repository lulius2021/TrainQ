VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# App base URL – used for OAuth redirects; falls back to window.location.origin if not set
VITE_APP_URL=https://your-domain.com

# CDN base URL for exercise images (Supabase Storage public bucket).
# After running scripts/upload-exercise-images.mjs set this to:
VITE_EXERCISES_CDN_URL=https://ilfsxckixlsyanuovfum.supabase.co/storage/v1/object/public/exercises

# Service role key is required for API routes (Server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Garmin Integration
GARMIN_CLIENT_ID=your-consumer-key
GARMIN_CLIENT_SECRET=your-consumer-secret
GARMIN_REDIRECT_URI=https://your-domain.com/api/garmin/callback

# In-App Purchases (RevenueCat / @capgo/native-purchases)
# iOS App Store product IDs (set in App Store Connect)
VITE_IAP_MONTHLY_ID=trainq.pro.monthly
VITE_IAP_YEARLY_ID=trainq.pro.yearly
# Android-only: Google Play subscription base plan IDs
VITE_IAP_ANDROID_MONTHLY_PLAN_ID=monthly
VITE_IAP_ANDROID_YEARLY_PLAN_ID=yearly

# RevenueCat webhook shared secret (set in RevenueCat dashboard → Integrations → Webhooks)
# Add this as a Supabase Edge Function secret: REVENUECAT_WEBHOOK_SECRET
REVENUECAT_WEBHOOK_SECRET=your-revenuecat-webhook-secret
